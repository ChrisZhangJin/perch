# perch.yaml.example — example configuration for perch.
#
# Copy this file to `perch.yaml` (or `~/.perch/perch.yaml`) and edit.
# At startup perch loads the YAML file at this path, then layers env vars on
# top, then falls back to built-in defaults. Precedence:
#
#     env vars  >  this YAML file  >  built-in defaults
#
# Secrets (AGENT_AUTH_CODE) MUST be set via env, never committed here.
# See README.md for the full design.
#
# First-run wizard: if any required field is missing AND stdin is a TTY,
# perch prompts for the missing fields interactively and writes the
# non-secret values to ~/.perch/perch.yaml (0600). That generated file
# carries every key below with its default — this example exists to explain
# them, not to be more complete.
#
# Every key perch understands appears in this file. Keys shown commented out
# are optional and display their built-in default; uncomment to override.

# --- Email provider --------------------------------------------------------
# Built-in names. Each one bakes in the right IMAP/SMTP endpoints and the
# per-provider transport quirks (IMAP ID requirement, IDLE support). The
# transport strategy is picked from these capabilities at startup:
#
#   163 / 126  → Poller  (short-conn, poll-only — server has no IDLE)
#   qq         → IMAPMailbox + IDLETrigger (long-conn, idle+poll)
#
# No additional config needed — perch picks based on the provider's
# built-in Capabilities.
email_provider:
  name: 163           # 163 | 126 | qq
  # name: 126
  # name: qq

# --- AI agent --------------------------------------------------------------
# Built-in names. Each one bakes in the right argv adapter (session-id /
# resume / yolo, etc.).
ai_agent:
  name: claude        # claude | nanopi | pi
  workdir: .          # cwd for the spawned agent
  permission_mode: acceptEdits   # claude only; ignored by nanopi/pi
                       #   acceptEdits        — auto-allow file edits
                       #   bypassPermissions  — auto-allow ALL tools
                       #   plan               — read-only planning mode
  # task_only: true    # DEFAULT true. No env override — YAML only.
                       # Injects a SAFETY PROTOCOL section into the agent
                       # prompt: read-only inspection and any op inside cwd
                       # are always allowed; destructive actions outside cwd
                       # (rm, sudo, curl to external hosts, package install,
                       # etc.) are refused UNLESS destruction IS the stated
                       # task. A light guardrail against email-body-borne
                       # side-requests; set false to disable.
  #
  # append_system_prompt: text layered onto the AGENT'S OWN system prompt on
  # every run (--append-system-prompt), for a standing role that outlives any
  # single email — "you are the support desk, the task definitions live in
  # ./tasks, never invent policy". This is NOT the per-email prompt perch
  # builds (that one carries SAFETY / GROUNDING / LANGUAGE and the reply
  # format); keep the two from contradicting each other.
  #
  # The value is text-or-path: a single-line value naming a readable file is
  # read as a file, anything else is used literally. A file is re-read on
  # every email, so edits take effect on the next message with no restart.
  # A fill-in-the-blanks help-desk definition ships at helpdesk.md.example
  # (with a sample task file in tasks.example/).
  #
  # Only agents that advertise the flag get it: perch runs `<agent> --help`
  # once at startup and, if the flag is missing (nanopi as of 2026-08-25),
  # logs a WARN and runs without it rather than failing every email.
  # Env override: APPEND_SYSTEM_PROMPT
  # append_system_prompt: /root/perch/helpdesk.md
  # append_system_prompt: |
  #   You are the kulink support desk. Task definitions live in ./tasks/.

# --- Prompt & history ------------------------------------------------------
# Not configurable (the old prompt.contracts / prompt.strip_quoted keys are
# ignored with a WARN). The fixed behaviour:
#   - New agent session: the prompt carries the full format contracts and the
#     email body as received, quoted history included (a forwarded thread is
#     often the whole task).
#   - Resumed session: compact contracts, and the quoted history is stripped —
#     the session already holds those turns.
#   - Every reply email perch sends quotes the message it answers, so the
#     thread history stays in the mailbox even though the agent's context
#     does not carry it.

# --- Loop protection -------------------------------------------------------
# Two mail robots answering each other never stop on their own — each side
# politely replies to the other's reply, forever, and every round costs an
# agent invocation on both sides. This happened in production between two
# perch instances after a whitelist was widened to a whole domain.
#
# Four defences, in order of how much they can be trusted:
#
#   1. perch labels its own replies `Auto-Submitted: auto-replied` (RFC 3834).
#      Always on. A compliant counterparty will not answer them.
#   2. skip_automated ignores inbound mail that labels ITSELF machine
#      generated: Auto-Submitted (anything but "no"), Precedence:
#      bulk|list|junk, or a List-Id / List-Unsubscribe / List-Post header.
#   3. Mail whose From is perch's own address is always ignored — no knob.
#      Guards against bounces, a Cc back to itself, and a whitelist wide
#      enough to match its own domain.
#   4. max_replies_per_hour caps replies per thread. This is the only one
#      that works against a robot which labels nothing at all, which is the
#      common case. 0 disables it.
#
# Set skip_automated false only if something you WANT answered sets those
# headers — a monitoring system or CI job mailing in a task legitimately sets
# Auto-Submitted: auto-generated.
#
# The real first line of defence is still allow_from. A regex like
# s".*@163.com" whitelists every address at that provider, including other
# robots and perch's own mailbox.
# No env override — YAML only.
loop_guard:
  skip_automated: true
  max_replies_per_hour: 10
  # peer_agents: other mail agents (e.g. another perch) to work with by
  # email. Their replies carry Auto-Submitted and are answered anyway; the
  # exchange ends via end_detect (turn it on) and, as a hard stop, the cap
  # above. Exact addresses only.
  # peer_agents:
  #   - agent_tommy@163.com

# --- Whitelist -------------------------------------------------------------
# ONLY these senders can wake the agent. Empty list = deny everyone
# (fail-closed, the safe default for env-only setups that never went
# through the wizard). A literal `*` entry accepts everyone — that's
# the onboarding default the setup wizard writes; tighten before going
# live on a real mailbox.
# Comma-separated when set via the ALLOW_FROM env var; YAML uses a real list.
# Each entry is either a literal address or a regex wrapped in `s"..."`:
#
#   - "*"                            # literal: accept everyone (wizard default)
#   - alice@163.com                   # literal (case-insensitive exact match)
#   - s".+@(foo|bar)\.example\.com"  # regex: any user on foo/bar .example.com
#   - s".*agent.*@qq\.com"           # regex: contains "agent" substring pattern
#   - s"(?i).+@trusted\.org"         # regex with case-insensitive flag
#
# Regexes are compiled at startup; a bad pattern fails the gate immediately
# (perch never starts in a fail-open state). The `s` prefix and matching
# trailing `"` are required — without them, the entry is treated as a
# literal address, NOT a regex. The bare `*` MUST be quoted in YAML
# (`"*"`), because unquoted `*` is the YAML alias indicator.
#
# Use ALLOW_FROM env var for literals only (regexes belong in the YAML file).
allow_from:
  - alice@163.com
  - s".*agent.*@qq\.com"
  # - bob@example.com
  # - s".+@(foo|bar)\.example\.com"
  # - "*"                          # uncomment to accept everyone

# --- Account ---------------------------------------------------------------
# The mailbox perch watches and replies from. The AGENT_EMAIL env var
# overrides this; the setup wizard writes the value here so unattended
# restarts don't have to re-enter it.
#
# The matching auth code is NEVER read from this file — set AGENT_AUTH_CODE
# in the environment. (For 163/126/qq this is the mailbox "authorization
# code", not your login password.)
email: agent@163.com                    # AGENT_EMAIL

# --- Loop timing -----------------------------------------------------------
poll_interval: 60s                       # POLL_INTERVAL (poll tick / IDLE keepalive)
                                         #   lower this if your server is poll-only
                                         #   (163/126: 10s feels snappier than 60s)
task_timeout: 30m                       # TASK_TIMEOUT (SIGTERM → 5s → SIGKILL)

# --- Long-task interim ack -------------------------------------------------
# When true, perch runs a lightweight classifier before the real task. If the
# classifier says "long", perch sends an interim ack email so you know the
# request landed while the real reply is still cooking. Off by default —
# every inbound triggers only one agent run unless you opt in.
# Env override: LONG_TASK_ACK=true
# long_task_ack: false
#
# classifier: who answers that "will this run long?" question.
#   agent — DEFAULT. Spawns the coding agent in a throwaway session; costs a
#           full extra agent run per inbound email.
#   jev   — asks TypeSafe AI's System One model (api.typesafe.ai) two typed
#           questions over HTTP instead. One round trip, ~100-500ms, which is
#           the whole cost objection to long_task_ack.
# The API key is env-only and never read from this file: export
# TYPESAFE_API_KEY. Without it (or on any error, timeout or unexpected
# answer) perch silently falls back to the agent probe, so switching this to
# jev can never stop the ack path working.
# classifier: agent
# jev_api_url: https://api.typesafe.ai/v1/systemone
# jev_model: jev-1.13.0    # pin a version; the "jev-latest" alias is refused
# jev_timeout: 10s         # short: the probe blocks the mail queue behind it
#
# end_detect: use Jev to spot a thread that is over — "thanks, got it", "ok
# 👍", "好的，谢谢" — and leave it unanswered instead of spending an agent run
# on a reply nobody wanted, which also invites a politeness ping-pong. Needs
# TYPESAFE_API_KEY; works independently of classifier above. Only ever applies
# to replies within an existing thread, never to a new email.
#
# end_detect_min_prob: how sure Jev must be before perch stays quiet. Set high
# on purpose — answering a "thanks" wastes one agent run, but wrongly staying
# quiet silently drops a real request and nobody ever finds out. Any error,
# timeout or unexpected answer means "reply as usual".
# end_detect: false
# end_detect_min_prob: 0.9
#
# llm: a chat model asked whenever Jev is unset or fails (e.g. HTTP 451 from
# mainland China), for both end_detect and the duration probe. Leave
# TYPESAFE_API_KEY unset and this is the replacement rather than a fallback.
# The key is env-only: export PERCH_LLM_API_KEY. Inert until base_url and
# model are both set.
#   format: openai    — POST {base_url}/chat/completions; logprobs give a
#                       calibrated P(over) (DeepSeek, Volcengine Ark, MiMo)
#           anthropic — POST {base_url}/v1/messages; no logprobs, so the
#                       answer is the model's word alone
# Order for both questions: Jev -> llm -> agent probe.
# If all three fail on a thread perch has already answered twice,
# perch stops: it sends a "notice" (which another perch never answers)
# instead of running the agent.
llm:
  format: openai
  base_url: ""      # e.g. https://api.deepseek.com (anthropic: https://api.deepseek.com/anthropic)
  model: ""         # e.g. deepseek-flash
  timeout: 2m       # reasoning models think before answering
  max_tokens: 128k    # reasoning counts against this; a small cap returns
                      # an empty answer. Lower it if the provider rejects
                      # it with HTTP 400. Plain numbers or k/m (1024k = 1m).

# --- Hooks -----------------------------------------------------------------
# on_email: a script perch runs for every inbound email it ACCEPTS, just
# before the agent runs. Use it for side effects perch itself doesn't do —
# record every new thread in a ledger, ping a phone, bump a counter.
#
# The script is called with five positional arguments:
#
#     $1  email_id      Message-Id header, e.g. <abc@163.com>
#                       ("" when the email carries no Message-Id — the
#                        argument is still passed, so $2..$5 never shift)
#     $2  subject
#     $3  body          text/plain, as received (before quote-stripping);
#                       truncated at 64 KiB
#     $4  sender        lowercased address, e.g. alice@163.com
#     $5  new_thread    or reply_thread — whether this email opened a new
#                       thread or continued one perch already has a session for
#
# Example ~/record.sh (chmod +x):
#
#     #!/usr/bin/env bash
#     [ "$5" = new_thread ] || exit 0
#     printf '%s\t%s\t%s\n' "$(date -Is)" "$4" "$2" >> "$HOME/perch-threads.tsv"
#
# The hook is an OBSERVER, never a gate: a missing script, a non-zero exit or
# a run that outlives `timeout` is logged (WARN) and the email is handled
# exactly as it would have been anyway. It only ever sees mail that already
# cleared allow_from and the loop guards. Runs with cwd = ai_agent.workdir.
# Env overrides: ON_EMAIL_HOOK, HOOK_TIMEOUT
hooks:
  # on_email: /home/agent/record.sh
  timeout: 30s                          # HOOK_TIMEOUT (SIGTERM → 5s → SIGKILL)

# --- Logging ---------------------------------------------------------------
# debug surfaces the full prompt/response flow (including message bodies);
# keep it at info or above on a real mailbox.
log_level: info                         # LOG_LEVEL (debug | info | warn | error)
log:
  # level: info                         # LOG_LEVEL; when set, overrides log_level above
  file: ""                              # LOG_FILE (e.g. ~/.perch/perch.log; empty = stderr)
  max_size_mb: 100                      # LOG_MAX_SIZE_MB (rotate at this size; 0 = never)
  max_backups: 5                        # LOG_MAX_BACKUPS (keeps perch.log.1 … perch.log.5)

# --- Email handling --------------------------------------------------------
max_prompt_bytes: 65536                 # MAX_PROMPT_BYTES (truncate huge bodies before
                                         #   the agent sees them — protects against
                                         #   absurdly large attachments / signatures)
max_attachment_bytes: 52428800          # MAX_ATTACHMENT_BYTES (per-attachment size cap,
                                         #   default 50 MB; oversized ones are dropped,
                                         #   the email still parses)

# --- Persistence -----------------------------------------------------------
# Thread-root → agent session UUID map (JSON). Survives restarts so a reply
# in the same thread resumes the same agent session.
# Env override: SESSION_STORE
# session_store: /var/lib/perch/sessions.json
# session_store: ./perch-sessions.json
# (default: $TMPDIR/perch-sessions.json)

# --- TLS -------------------------------------------------------------------
# DEV/TEST ONLY — accepts self-signed certs (e.g. a local GreenMail).
# NEVER enable against a real mailbox.
# Env override: TLS_INSECURE_SKIP_VERIFY
# tls_insecure_skip_verify: false
